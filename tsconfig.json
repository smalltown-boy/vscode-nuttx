{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "./out",
    "rootDir": "./src",
    "strict": false,

    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
